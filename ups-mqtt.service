[Unit]
Description=UPS MQTT Bridge (NUT)
After=network-online.target tailscaled.service mosquitto.service
Wants=network-online.target

# tailscaled is listed only for ordering: where the broker is reached over
# Tailscale, starting before the tunnel exists means the first connect fails.
# The daemon retries until it succeeds, so this only saves a few retries at
# boot. On hosts without Tailscale the unit does not exist and the ordering
# is simply ignored.
#
# mosquitto is likewise ordering only, for hosts that publish to a local
# broker: when both start at boot, it starts first. It is deliberately not in
# Wants=, so a host where Mosquitto is disabled does not have it started
# behind its admin's back; the connect retry covers a broker that is late.

[Service]
Type=simple
User=SERVICE_USER
ExecStart=/usr/local/bin/ups-mqtt --config /etc/ups-mqtt/config.toml
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
